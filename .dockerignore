# Ignore node_modules everywhere
**/node_modules
node_modules

# Ignore build outputs
**/.next
**/dist
**/out

# Ignore local environment files (Coolify sets env vars)
.env
.env.*
!.env.example

# Ignore logs
**/*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore editor/OS files
.DS_Store
Thumbs.db
.idea
.vscode
*.swp

# Ignore test coverage and temp files
coverage
tmp
temp

# Ignore Turbo cache
**/.turbo

# Ignore Prisma generated client (will be re-generated in container)
packages/db/prisma/client
